# Copy to .env beside package.json. The launcher (bin/switchgen) sources it;
# for a bare `npm run dev` export these yourself. Every value is optional.

# ComfyUI's HTTP address. The app proxies to it, so one origin serves both.
COMFY_URL=http://127.0.0.1:8188

# Where the app listens. It binds every interface so a phone on the LAN or
# the tailnet can reach it.
SWITCHGEN_PORT=5273

# Extra hostnames the app may be reached by, comma separated. localhost, this
# machine's hostname, its IP addresses and any *.ts.net name are always
# allowed; add a LAN DNS name or a reverse-proxy name here.
#SWITCHGEN_ALLOWED_HOSTS=studio.lan,switchgen.example.com

# The model library and the outputs folder. The models root must be the same
# one ComfyUI reads through extra_model_paths.yaml, and the outputs folder the
# one ComfyUI writes to (--output-directory).
SWITCHGEN_MODELS=/mnt/storage/ai/models
SWITCHGEN_OUTPUTS=/mnt/storage/ai/outputs

# The shared archive file. Defaults to <outputs>/.switchgen/archive.json.
#SWITCHGEN_ARCHIVE=

# The ComfyUI checkout and its Python, for the picture reader (WD14 tagger and
# YOLO detectors run through this interpreter, on the CPU).
SWITCHGEN_COMFY=/mnt/storage/repos/ComfyUI
#SWITCHGEN_COMFY_INPUT=/mnt/storage/repos/ComfyUI/input
#SWITCHGEN_PYTHON=/mnt/storage/repos/ComfyUI/venv/bin/python
#SWITCHGEN_WD14=/mnt/storage/ai/models/wd14

# Binaries. Downloads need aria2c; the reel needs ffmpeg and ffprobe.
#SWITCHGEN_ARIA2C=/usr/bin/aria2c
#SWITCHGEN_FFMPEG=/usr/bin/ffmpeg
#SWITCHGEN_FFPROBE=/usr/bin/ffprobe

# HuggingFace token file, only ever sent to HuggingFace, for gated files.
#HF_TOKEN_FILE=~/.cache/huggingface/token

# The catalogue and the LoRA folder the indexer reads.
#SWITCHGEN_CATALOG=server/catalog.json
#SWITCHGEN_LORA_DIR=/mnt/storage/ai/models/Lora

# Origins a TLS-terminating proxy may present, comma separated.
#SWITCHGEN_TRUSTED_ORIGINS=https://switchgen.example.com
