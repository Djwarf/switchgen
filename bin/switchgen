#!/usr/bin/env bash
# SwitchGen launcher. Works from any checkout: paths are taken from where
# this script lives, and every setting can be overridden in a .env file
# beside package.json or in the environment. See README.md.
set -euo pipefail

APP="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$APP"

# .env is sourced so the server middlewares see SWITCHGEN_* and COMFY_URL.
if [ -f .env ]; then set -a; . ./.env; set +a; fi

COMFY_URL="${COMFY_URL:-http://127.0.0.1:8188}"
PORT="${SWITCHGEN_PORT:-5273}"
URL="http://localhost:${PORT}"
LOG=/tmp/switchgen-preview.log
NO_OPEN="${SWITCHGEN_NO_OPEN:-}"
# README gives `switchgen --no-open`; the usage line gives `start --no-open`.
if [ "${1:-}" = "--no-open" ] || [ "${2:-}" = "--no-open" ]; then NO_OPEN=1; fi

comfy_up() { curl -sf -o /dev/null "$COMFY_URL/system_stats"; }

# Is SwitchGen itself answering on the port? Anything could be listening
# there, so ask the one route only this server answers that way.
app_up() {
  local body
  body=$(curl -sf "$URL/api/capabilities" 2>/dev/null) || return 1
  [[ $body == *'"server":"switchgen"'* ]]
}

# This checkout's preview server and nothing else. `pkill -f "vite preview"`
# matched any process whose command line held those words: another
# project's preview server, or a grep for them. The server's command line
# begins with node and this checkout's own vite, so match that from the
# start, with the regex characters in the path escaped.
server_pattern() {
  local esc
  esc=$(printf '%s' "$APP" | sed 's/[][\.*^$+?(){}|]/\\&/g')
  printf '^([^ ]*/)?node %s/node_modules/\\.bin/vite preview' "$esc"
}

open_app() {
  if [ -z "$NO_OPEN" ]; then
    command -v xdg-open >/dev/null && xdg-open "$URL" >/dev/null 2>&1 || true
  fi
}

# The https address Tailscale Serve gives this app, when it is set up for
# this port. A phone needs it: over plain http a browser runs no service
# worker, gives no clipboard and no screen wake lock, and will not install
# the page as an app. Only read here; the serve config is never changed.
serve_url() {
  command -v tailscale >/dev/null || return 1
  local json
  # Bounded, so a tailscaled that is still starting (at boot, under the
  # user unit) cannot hold up the server.
  json=$(timeout 5 tailscale serve status --json 2>/dev/null) || return 1
  printf '%s' "$json" | PORT="$PORT" node -e '
    let text = ""
    process.stdin.on("data", (d) => { text += d })
    process.stdin.on("end", () => {
      let cfg
      try { cfg = JSON.parse(text || "{}") } catch { process.exit(1) }
      // A background config, and any serve running in the foreground.
      const all = [cfg, ...Object.values(cfg.Foreground ?? {})]
      const port = process.env.PORT
      const ours = new RegExp(`^(https?://)?(localhost|127\\.0\\.0\\.1|\\[::1\\])?:?${port}/?$`)
      for (const c of all) {
        for (const [hostPort, web] of Object.entries(c.Web ?? {})) {
          const at = hostPort.lastIndexOf(":")
          const host = hostPort.slice(0, at)
          const listen = hostPort.slice(at + 1)
          // The app asks for /api and /comfy from the root, so only a
          // handler at "/" serves it, and only an https one helps a phone.
          if (!c.TCP?.[listen]?.HTTPS) continue
          if (!ours.test(String(web?.Handlers?.["/"]?.Proxy ?? ""))) continue
          console.log(listen === "443" ? `https://${host}` : `https://${host}:${listen}`)
          process.exit(0)
        }
      }
      process.exit(1)
    })'
}

# This machine's name on the tailnet, for the hint below.
tailnet_name() {
  command -v tailscale >/dev/null || return 1
  timeout 5 tailscale status --json 2>/dev/null | node -e '
    let text = ""
    process.stdin.on("data", (d) => { text += d })
    process.stdin.on("end", () => {
      try {
        const name = String(JSON.parse(text).Self?.DNSName ?? "").replace(/\.$/, "")
        if (!name) process.exit(1)
        console.log(name)
      } catch { process.exit(1) }
    })'
}

# Where the phone should open the app: the https address when Tailscale
# Serve is set up for it, or else the one command that sets it up. Nothing
# is said on a machine without Tailscale.
phone_line() {
  local https name
  if https=$(serve_url); then
    echo "On the phone: $https"
  elif name=$(tailnet_name); then
    echo "For the phone, put https in front once with: tailscale serve --bg $PORT"
    echo "then open https://$name there (README.md, \"Use it from a phone\")."
  fi
  return 0
}

ensure_comfy() {
  if comfy_up; then return; fi
  if systemctl --user cat comfyui >/dev/null 2>&1; then
    systemctl --user start comfyui
    printf "Waiting for ComfyUI at %s" "$COMFY_URL"
    for _ in $(seq 1 90); do comfy_up && break; printf "."; sleep 1; done
    # The wait used to end with " up" whether or not anything answered.
    if comfy_up; then
      echo " up"
    else
      echo " still not answering. See why with: journalctl --user -u comfyui"
      echo "The app will open anyway and retry every few seconds."
    fi
  else
    # The enable step is a block of its own, after the edit. In one block
    # with the copy, pasting it enabled the unit as shipped, and where its
    # paths are wrong it fails to start and Restart=always tries again every
    # five seconds.
    cat >&2 <<MSG
ComfyUI is not answering at $COMFY_URL and there is no user service to start.
Start it yourself (see README.md, "Install ComfyUI"), or install the sample
unit. First copy it:
  mkdir -p ~/.config/systemd/user
  cp "$APP/contrib/comfyui.service" ~/.config/systemd/user/
Then, in ~/.config/systemd/user/comfyui.service, change %h/ComfyUI to the
folder ComfyUI is in and %h/ai/outputs to the folder SWITCHGEN_OUTPUTS
names. Only after that, enable it:
  systemctl --user daemon-reload && systemctl --user enable --now comfyui
The app will open anyway and retry every few seconds.
MSG
  fi
}

# The old launcher built only when dist/ was missing, so every change was
# served stale until someone remembered. Now anything newer than the last
# build triggers one.
needs_build() {
  [ -f dist/index.html ] || return 0
  [ -n "$(find src server public index.html vite.config.ts package.json -newer dist/index.html -print -quit 2>/dev/null)" ]
}

case "${1:-start}" in
  start|""|--no-open)
    [ -d node_modules ] || npm install
    ensure_comfy
    # A running server keeps serving the code it started with, and a second
    # one cannot have the port. Building under it would pair a new page with
    # the old server, so say what is running and leave it be.
    if app_up; then
      echo "SwitchGen is already running: $URL"
      if needs_build; then
        echo "Changes since it started are not being served. Run 'switchgen stop', then 'switchgen'."
      fi
      phone_line
      open_app
      exit 0
    fi
    if needs_build; then echo "Building."; npm run build; fi
    nohup npm run preview >"$LOG" 2>&1 &
    pid=$!
    up=""
    for _ in $(seq 1 30); do
      if app_up; then up=1; break; fi
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
    # The launcher used to print the address and open it whether or not
    # anything had started. Say what happened, and where the log is.
    if [ -z "$up" ]; then
      if kill -0 "$pid" 2>/dev/null; then
        echo "SwitchGen has not answered at $URL yet. Its log is $LOG." >&2
      else
        echo "SwitchGen did not start. The end of $LOG:" >&2
        tail -n 20 "$LOG" >&2
      fi
      exit 1
    fi
    echo "SwitchGen: $URL"
    phone_line
    open_app
    ;;
  serve)
    # The server in the foreground, for a service manager to run and watch
    # (contrib/switchgen.service). Vite is run straight, with no npm between,
    # so a stop signal reaches it and `switchgen stop` still finds it.
    [ -d node_modules ] || npm install
    if app_up; then
      # Exiting cleanly, so a unit started beside a copy run by hand is not
      # restarted over and over against a port that copy holds.
      echo "SwitchGen is already running at $URL; stop it to let this one serve."
      exit 0
    fi
    if needs_build; then
      echo "Building."
      # A build that fails will fail again, so it is not one to retry: the
      # unit leaves exit status 3 alone (RestartPreventExitStatus).
      npm run build || { echo "The build failed; nothing is served until it is fixed." >&2; exit 3; }
    fi
    phone_line
    exec "$APP/node_modules/.bin/vite" preview
    ;;
  dev)
    # Two servers on one archive each keep their own copy of it and write it
    # whole, so the second to save undoes the first's records. The dev
    # server used to start beside the running app without a word, on the
    # next free port, with the same archive.
    if app_up; then
      echo "SwitchGen is already serving at $URL, on the same archive a dev server would use." >&2
      echo "Stop it first with 'switchgen stop', or give the dev server its own SWITCHGEN_PORT and SWITCHGEN_ARCHIVE." >&2
      exit 1
    fi
    [ -d node_modules ] || npm install
    ensure_comfy
    npm run dev
    ;;
  phone)    phone_line ;;
  build)    npm run build ;;
  validate) npm run validate ;;
  stop)
    pattern="$(server_pattern)"
    if pkill -f "$pattern"; then
      # Wait for the port to be let go, so `switchgen stop && switchgen`
      # starts a fresh server instead of finding the old one still there.
      for _ in $(seq 1 20); do pgrep -f "$pattern" >/dev/null || break; sleep 0.5; done
      echo "SwitchGen stopped (ComfyUI left running)"
    else
      echo "SwitchGen was not running from $APP"
    fi
    ;;
  install)
    mkdir -p "$HOME/.local/bin"
    ln -sf "$APP/bin/switchgen" "$HOME/.local/bin/switchgen"
    echo "Linked $HOME/.local/bin/switchgen -> $APP/bin/switchgen"
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "Add $HOME/.local/bin to your PATH." ;; esac
    ;;
  *) echo "usage: switchgen {start [--no-open]|serve|dev|phone|build|validate|stop|install}"; exit 1 ;;
esac
